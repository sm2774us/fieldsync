# Generate real secrets with: fieldsync-admin init   (production: KMS/HSM-held signing key, OIDC/mTLS at the edge)
SYNC_SIGNING_KEY=
SYNC_TOKEN_SECRET=
# No heartbeat for 2 intervals (60 s): "delayed". Silent for this many seconds: "offline" (raises an alert)
SYNC_OFFLINE_AFTER_S=3600
# Device-reported queue depth that raises a BACKLOG_HIGH alert
SYNC_BACKLOG_ALERT=1000
